---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ImageLightbox from "../../../components/ImageLightbox.astro";
import { render } from "astro:content";
import { getLabels, normalizeLocale, LOCALES, BCP47 } from "../../../i18n";
import { getLocalizedCollection, stripLocale, isVisibleInDev } from "../../../i18n/content";
import { localeUrl } from "../../../i18n/url";
import {
  getSeriesByKey,
  isSeriesPostSlug,
  groupSeriesPostsByCategory,
} from "../../../utils/blog-series";

export async function getStaticPaths() {
  const paths = [];
  for (const lang of LOCALES) {
    const products = await getLocalizedCollection("product", lang);
    for (const product of products) {
      paths.push({
        params: { lang, slug: stripLocale(product.id) },
        props: { product },
      });
    }
  }
  return paths;
}

const { product } = Astro.props;
const lang = normalizeLocale(Astro.params.lang);
const t = getLabels(lang);
const { common, product: productLabels, lightbox } = t;
const { Content } = await render(product);

const currentSlug = stripLocale(product.id);
const allProducts = await getLocalizedCollection("product", lang);
const childProducts = allProducts
  .filter((p) => p.data.parent === currentSlug)
  .sort((a, b) => a.data.order - b.data.order);

// 連載ブログ一覧（このプロダクトに blogSeriesKey が設定されている場合のみ）。
// slug ベースで該当記事を集め、未来日付/下書きを除く（公開判定はブログ一覧と共通）。
const series = product.data.blogSeriesKey
  ? getSeriesByKey(product.data.blogSeriesKey)
  : undefined;
const seriesPostsAll = series
  ? (await getLocalizedCollection("blog", lang))
      .filter(isVisibleInDev)
      .filter((p) => isSeriesPostSlug(stripLocale(p.id), series))
  : [];
// テーマ別グループ（categoryOrder の順／各グループ内は日付降順＝最新が先頭）。
const seriesGroups = series
  ? groupSeriesPostsByCategory(seriesPostsAll, series)
  : [];
// JSON-LD 用に日付降順のフラット配列も保持する。
const seriesPosts = [...seriesPostsAll].sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
// アコーディオンは既定で全て閉じる（初期表示を短く保ち、縦長化を防ぐ）。
const seriesCategoryLabels = productLabels.blogSeries.categories as Record<
  string,
  string
>;

// 連載が一塊のコンテンツ群であることを検索エンジンに伝える ItemList 構造化データ。
const seriesItemList =
  seriesPosts.length > 0
    ? [
        {
          "@context": "https://schema.org",
          "@type": "ItemList",
          name: `${product.data.title} — ${productLabels.blogSeries.title}`,
          itemListElement: seriesPosts.map((p, i) => ({
            "@type": "ListItem",
            position: i + 1,
            url: new URL(
              localeUrl(lang, `blog/${stripLocale(p.id)}/`),
              Astro.site,
            ).toString(),
            name: p.data.title,
          })),
        },
      ]
    : [];
---

<BaseLayout
  title={product.data.title}
  description={product.data.description}
  extraJsonLd={seriesItemList}
>
  <article class="prose">
    <header class="hero-gradient fade-in">
      <span class={`status status-${product.data.status}`}>
        {product.data.status === "active"
          ? productLabels.statusLabels.active
          : product.data.status === "beta"
            ? productLabels.statusLabels.beta
            : product.data.status === "suspended"
              ? productLabels.statusLabels.suspended
              : productLabels.statusLabels.archived}
      </span>
      <h1>{product.data.title}</h1>
      <p class="tagline">{product.data.tagline}</p>
      <p class="description">{product.data.description}</p>
      <div class="meta">
        <div class="tags">
          {product.data.tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      </div>
      {
        product.data.status === "suspended" && (
          <p class="suspended-notice" role="status">
            {productLabels.suspendedNotice}
          </p>
        )
      }
      <div class="header-actions">
        {
          product.data.url && product.data.status === "suspended" ? (
            <span class="btn-primary btn-disabled" aria-disabled="true">
              {productLabels.suspendedLink}
            </span>
          ) : (
            product.data.url && (
              <a
                href={product.data.url}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary"
              >
                {productLabels.tryLink} &rarr;
              </a>
            )
          )
        }
        {
          product.data.repo && (
            <a
              href={product.data.repo}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary"
            >
              {productLabels.githubLink}
            </a>
          )
        }
      </div>
    </header>

    <!-- モバイル: 折りたたみ目次 -->
    <nav class="toc-mobile reveal" aria-label={common.tocTitle}>
      <button class="toc-mobile-toggle" type="button" aria-expanded="false">
        <span class="toc-mobile-icon">&#9776;</span>
        <span>{common.tocTitle}</span>
        <span class="toc-mobile-chevron">&#9660;</span>
      </button>
      <ol class="toc-mobile-list" id="tocMobileList"></ol>
    </nav>

    <div class="product-layout">
      <div class="content reveal">
        <Content />
      </div>

      <!-- PC: サイドバー固定目次 -->
      <aside class="toc-sidebar" aria-label={common.tocTitle}>
        <nav class="toc-sidebar-inner">
          <p class="toc-sidebar-title">{common.tocTitle}</p>
          <ol class="toc-sidebar-list" id="tocSidebarList"></ol>
        </nav>
      </aside>
    </div>
    {childProducts.length > 0 && (
      <section class="sub-pages reveal" aria-labelledby="sub-pages-heading">
        <h2 id="sub-pages-heading">{productLabels.subPagesTitle}</h2>
        <p class="sub-pages-intro">{productLabels.subPagesIntro}</p>
        <div class="sub-pages-grid">
          {childProducts.map((child) => (
            <a
              href={localeUrl(lang, `product/${stripLocale(child.id)}/`)}
              class:list={["sub-page-card", child.data.audience && `sub-page-card-${child.data.audience}`]}
            >
              {child.data.audience && (
                <span class={`audience-badge audience-${child.data.audience}`}>
                  {productLabels.audienceLabels[child.data.audience]}
                </span>
              )}
              <h3>{child.data.title}</h3>
              <p class="sub-page-tagline">{child.data.tagline}</p>
              <p class="sub-page-description">{child.data.description}</p>
              <div class="tags">
                {child.data.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
              <span class="sub-page-detail">{productLabels.detailLink} &rarr;</span>
            </a>
          ))}
        </div>
      </section>
    )}
    {seriesGroups.length > 0 && (
      <section class="blog-series reveal" aria-labelledby="blog-series-heading">
        <h2 id="blog-series-heading">{productLabels.blogSeries.title}</h2>
        <p class="blog-series-intro">{productLabels.blogSeries.intro}</p>
        <div class="blog-series-groups">
          {seriesGroups.map((group) => (
            <details class="blog-series-category" id={`series-${group.key}`}>
              <summary>
                <span class="blog-series-category-name">
                  {seriesCategoryLabels[group.key] ?? group.key}
                </span>
                <span class="blog-series-category-count">{group.posts.length}</span>
              </summary>
              <ul class="blog-series-list">
                {group.posts.map((p) => (
                  <li class="blog-series-item">
                    <a
                      href={localeUrl(lang, `blog/${stripLocale(p.id)}/`)}
                      class="blog-series-card"
                      data-astro-reload
                    >
                      <span class="blog-series-date">
                        {p.data.date.toLocaleDateString(BCP47[lang])}
                      </span>
                      <h3>{p.data.title}</h3>
                      <p class="blog-series-desc">{p.data.description}</p>
                      <span class="blog-series-readmore">{productLabels.blogSeries.readMore} &rarr;</span>
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          ))}
        </div>
      </section>
    )}
  </article>
  {!product.data.audience && (
    <section class="bottom-cta reveal">
      <h2>{common.ctaTitle}</h2>
      <p>{common.ctaBody}</p>
      <a href={localeUrl(lang, "contact/")} class="btn-cta">{common.ctaButton}</a>
    </section>
  )}
  <nav class="back reveal">
    <a href="#" onclick="history.back(); return false;">&larr; {common.backLink}</a>
  </nav>

  {product.data.url && product.data.status !== "suspended" && (currentSlug === "tasukiba" || product.data.parent === "tasukiba") && (
    <div class="app-float" id="appFloat" data-app-key={currentSlug}>
      <a
        href={product.data.url}
        target="_blank"
        rel="noopener noreferrer"
        class="app-float-link"
        aria-label={productLabels.appFloat.aria}
      >
        <img
          src="/HomePage/mascot-owl.png"
          alt=""
          width="36"
          height="36"
          class="app-float-icon"
          loading="lazy"
          decoding="async"
        />
        <span class="app-float-text">{productLabels.appFloat.text}</span>
        <span class="app-float-arrow" aria-hidden="true">&rarr;</span>
      </a>
      <button
        type="button"
        class="app-float-close"
        aria-label={productLabels.appFloat.dismissAria}
      >&times;</button>
    </div>
  )}

  <ImageLightbox labels={lightbox} />

  <script is:inline>
    // ===== 目次（TOC）の自動生成 =====
    function initProductToc() {
      var content = document.querySelector(".content");
      var mobileList = document.getElementById("tocMobileList");
      var sidebarList = document.getElementById("tocSidebarList");
      if (!content || (!mobileList && !sidebarList)) return;

      // 記事内の H2/H3 を取得（H4 以下は目次に含めない）
      var headings = content.querySelectorAll("h2, h3");
      if (headings.length === 0) {
        // 見出しがない記事では目次を非表示
        var tocMobile = document.querySelector(".toc-mobile");
        var tocSidebar = document.querySelector(".toc-sidebar");
        if (tocMobile) tocMobile.style.display = "none";
        if (tocSidebar) tocSidebar.style.display = "none";
        return;
      }

      // 既存の目次項目をクリア（astro:after-swap での再生成に対応）
      if (mobileList) mobileList.innerHTML = "";
      if (sidebarList) sidebarList.innerHTML = "";

      var fragment1 = document.createDocumentFragment();
      var fragment2 = document.createDocumentFragment();
      var observeTargets = [];
      var h2Count = 0;
      var h3Count = 0;

      headings.forEach(function (h, i) {
        if (!h.id) {
          h.id = "heading-" + i;
        }

        var text = (h.textContent || "").trim();
        if (!text) return;

        var isH3 = h.tagName === "H3";

        var num;
        if (isH3) {
          h3Count++;
          num = h2Count + "." + h3Count;
        } else {
          h2Count++;
          h3Count = 0;
          num = String(h2Count);
        }

        observeTargets.push(h);

        function createTocItem(className) {
          var li = document.createElement("li");
          if (isH3) li.className = "toc-indent";
          var a = document.createElement("a");
          a.href = "#" + h.id;
          var numSpan = document.createElement("span");
          numSpan.className = "toc-num";
          numSpan.textContent = num;
          var labelSpan = document.createElement("span");
          labelSpan.className = "toc-label";
          labelSpan.textContent = text;
          a.appendChild(numSpan);
          a.appendChild(labelSpan);
          if (className) a.setAttribute("data-heading-id", h.id);
          li.appendChild(a);
          return li;
        }

        if (mobileList) {
          var li1 = createTocItem(null);
          li1.querySelector("a").addEventListener("click", function () {
            var toggle = document.querySelector(".toc-mobile-toggle");
            var list = document.getElementById("tocMobileList");
            if (toggle && list) {
              toggle.setAttribute("aria-expanded", "false");
              list.classList.remove("is-open");
            }
          });
          fragment1.appendChild(li1);
        }

        if (sidebarList) {
          fragment2.appendChild(createTocItem("sidebar"));
        }
      });

      if (mobileList) mobileList.appendChild(fragment1);
      if (sidebarList) sidebarList.appendChild(fragment2);

      // モバイル: 折りたたみトグル
      var toggleBtn = document.querySelector(".toc-mobile-toggle");
      if (toggleBtn && mobileList) {
        // 既存のリスナーをクリアするため、ボタンを差し替え
        var newToggle = toggleBtn.cloneNode(true);
        toggleBtn.parentNode.replaceChild(newToggle, toggleBtn);
        newToggle.addEventListener("click", function () {
          var isOpen = newToggle.getAttribute("aria-expanded") === "true";
          newToggle.setAttribute("aria-expanded", isOpen ? "false" : "true");
          mobileList.classList.toggle("is-open", !isOpen);
        });
      }

      // PC: Intersection Observer で現在位置をハイライト
      if (sidebarList && observeTargets.length > 0 && typeof IntersectionObserver !== "undefined") {
        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            var links = sidebarList.querySelectorAll("a");
            links.forEach(function (link) {
              link.classList.toggle(
                "is-active",
                link.getAttribute("data-heading-id") === entry.target.id
              );
            });
          });
        }, { rootMargin: "-80px 0px -60% 0px", threshold: 0 });

        observeTargets.forEach(function (target) {
          observer.observe(target);
        });
      }
    }
    initProductToc();

    // ===== URL ハッシュで指定された details アコーディオンを開く =====
    // 例: .../product/tasukiba-user/#terms で利用規約アコーディオンを開いた状態にする。
    // ネストした faq-category > faq-item にも対応するため祖先 details も併せて開く。
    function openHashAccordion() {
      var hash = location.hash;
      if (!hash || hash.length < 2) return;
      var id;
      try {
        id = decodeURIComponent(hash.slice(1));
      } catch (e) {
        id = hash.slice(1);
      }
      var target = document.getElementById(id);
      if (!target) return;
      // target 自身が details でなければ、内包する直近の details を対象にする
      var el = target.tagName === "DETAILS"
        ? target
        : (target.closest ? target.closest("details") : null);
      if (!el) return;
      // 対象とその祖先の details をすべて開く
      var node = el;
      while (node && node.tagName === "DETAILS") {
        node.open = true;
        node = node.parentElement ? node.parentElement.closest("details") : null;
      }
      // 開いた後に正しい位置へスクロール（閉じた状態での誤ったジャンプを補正）
      if (target.scrollIntoView) {
        target.scrollIntoView({ behavior: "auto", block: "start" });
      }
    }
    openHashAccordion();
    window.addEventListener("hashchange", openHashAccordion);

    // ===== アプリ導線の固定ピル =====
    // リンク自体は JS 無効でも表示・クロール可能（CSS で初期表示）。
    // JS はセッション内の「閉じた」状態の記憶と閉じる操作のみを担う。
    function initAppFloat() {
      var el = document.getElementById("appFloat");
      if (!el) return;
      var key = "appFloatDismissed:" + (el.getAttribute("data-app-key") || "");
      try {
        if (sessionStorage.getItem(key) === "1") {
          el.classList.add("is-dismissed");
          return;
        }
      } catch (e) {}
      var closeBtn = el.querySelector(".app-float-close");
      if (closeBtn && closeBtn.dataset.bound !== "1") {
        closeBtn.dataset.bound = "1";
        closeBtn.addEventListener("click", function () {
          el.classList.add("is-dismissed");
          try { sessionStorage.setItem(key, "1"); } catch (e) {}
        });
      }
    }
    initAppFloat();

    document.addEventListener("astro:after-swap", function () {
      initProductToc();
      openHashAccordion();
      initAppFloat();
    });
  </script>
</BaseLayout>

<style>
  /* ===== Product Layout (本文と TOC は分離。TOC は画面右に fixed) ===== */
  .product-layout {
    display: block;
  }
  .product-layout .content {
    width: 100%;
  }

  /* ===== コンテンツ内の H2 セクション区切り ===== */
  .content :global(h2) {
    margin-top: 3.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-border);
  }
  .content :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  /* ===== コンテンツ内のテーブル装飾 ===== */
  .content :global(table) {
    border-collapse: collapse;
    width: 100%;
    margin: 1.5rem 0;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    overflow: hidden;
    font-size: 0.92rem;
  }
  /* モバイル/タブレットでは横スクロール可能にする（列が画面幅を超えた場合の見切れ防止） */
  @media (max-width: 1024px) {
    .content :global(table) {
      display: block;
      width: 100%;
      max-width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
    .content :global(th:first-child),
    .content :global(td:first-child) {
      white-space: nowrap;
    }
  }
  .content :global(thead) {
    background-color: rgba(99, 102, 241, 0.08);
  }
  :global(.dark) .content :global(thead) {
    background-color: rgba(139, 92, 246, 0.12);
  }
  .content :global(th) {
    padding: 0.75rem 1rem;
    text-align: left;
    font-weight: 700;
    color: var(--color-text);
    border-bottom: 2px solid var(--color-border);
  }
  .content :global(td) {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
  }
  .content :global(tbody tr:last-child td) {
    border-bottom: none;
  }
  .content :global(tbody tr:nth-child(even)) {
    background-color: rgba(0, 0, 0, 0.02);
  }
  :global(.dark) .content :global(tbody tr:nth-child(even)) {
    background-color: rgba(255, 255, 255, 0.03);
  }

  /* ===== コンテンツ内の details カテゴリ（FAQ のグループ見出し） ===== */
  .content :global(details.faq-category) {
    margin: 1.5rem 0;
    border: 2px solid var(--color-border);
    border-radius: 0.75rem;
    background-color: var(--color-bg);
    overflow: hidden;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .content :global(details.faq-category[open]) {
    border-color: var(--color-accent);
    box-shadow: 0 4px 14px rgba(139, 92, 246, 0.1);
  }
  .content :global(details.faq-category > summary) {
    padding: 1.1rem 1.5rem;
    font-weight: 700;
    font-size: 1.15rem;
    cursor: pointer;
    color: var(--color-text);
    list-style: none;
    position: relative;
    padding-right: 3rem;
    background-color: rgba(139, 92, 246, 0.05);
    transition: background-color 0.2s, color 0.2s;
  }
  :global(.dark) .content :global(details.faq-category > summary) {
    background-color: rgba(139, 92, 246, 0.1);
  }
  .content :global(details.faq-category > summary::-webkit-details-marker) {
    display: none;
  }
  .content :global(details.faq-category > summary::after) {
    content: "▼";
    position: absolute;
    right: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.85rem;
    color: var(--color-accent);
    transition: transform 0.25s;
  }
  .content :global(details.faq-category[open] > summary::after) {
    transform: translateY(-50%) rotate(180deg);
  }
  .content :global(details.faq-category > summary:hover) {
    background-color: rgba(139, 92, 246, 0.1);
    color: var(--color-accent);
  }
  :global(.dark) .content :global(details.faq-category > summary:hover) {
    background-color: rgba(139, 92, 246, 0.18);
  }
  /* カテゴリ内のアイテム余白 */
  .content :global(details.faq-category > details.faq-item) {
    margin: 0.5rem 1rem;
  }
  .content :global(details.faq-category > details.faq-item:first-of-type) {
    margin-top: 1rem;
  }
  .content :global(details.faq-category > details.faq-item:last-of-type) {
    margin-bottom: 1rem;
  }

  /* ===== コンテンツ内の details アコーディオン（FAQ等） ===== */
  .content :global(details.faq-item) {
    margin: 0.75rem 0;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background-color: var(--color-surface);
    overflow: hidden;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .content :global(details.faq-item[open]) {
    border-color: var(--color-primary);
    box-shadow: 0 2px 8px rgba(99, 102, 241, 0.08);
  }
  .content :global(details.faq-item summary) {
    padding: 1rem 1.25rem;
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
    color: var(--color-text);
    list-style: none;
    position: relative;
    padding-right: 2.5rem;
    transition: background-color 0.2s, color 0.2s;
  }
  .content :global(details.faq-item summary::-webkit-details-marker) {
    display: none;
  }
  .content :global(details.faq-item summary::after) {
    content: "+";
    position: absolute;
    right: 1.25rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.4rem;
    font-weight: 400;
    color: var(--color-accent);
    transition: transform 0.25s;
    line-height: 1;
  }
  .content :global(details.faq-item[open] summary::after) {
    content: "−";
  }
  .content :global(details.faq-item summary:hover) {
    background-color: rgba(99, 102, 241, 0.04);
    color: var(--color-primary);
  }
  :global(.dark) .content :global(details.faq-item summary:hover) {
    background-color: rgba(99, 102, 241, 0.08);
  }
  .content :global(details.faq-item[open] summary) {
    border-bottom: 1px solid var(--color-border);
  }
  /* details 内部の本文余白 */
  .content :global(details.faq-item > *:not(summary)) {
    padding-left: 1.25rem;
    padding-right: 1.25rem;
  }
  .content :global(details.faq-item > *:not(summary):first-of-type) {
    margin-top: 1rem;
  }
  .content :global(details.faq-item > *:not(summary):last-child) {
    margin-bottom: 1rem;
  }
  /* details 内部の H2 区切り線は不要（faq-item 自体が枠なので） */
  .content :global(details.faq-item h2) {
    margin-top: 1rem;
    padding-top: 0;
    border-top: none;
  }

  /* ===== コンテンツ内の blockquote（引用ブロック）強調 ===== */
  .content :global(blockquote) {
    margin: 1.25rem 0;
