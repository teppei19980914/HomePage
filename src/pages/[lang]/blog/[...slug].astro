---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ImageLightbox from "../../../components/ImageLightbox.astro";
import { render } from "astro:content";
import { getLabels, normalizeLocale, BCP47, LOCALES } from "../../../i18n";
import { getLocalizedCollection, stripLocale, isVisibleInDev } from "../../../i18n/content";
import { localeUrl } from "../../../i18n/url";
import { buildXShareUrl } from "../../../utils/share";
import { estimateReadingTime } from "../../../utils/reading-time";
import { tagToSlug } from "../../../utils/blog-tags";
import { findSeriesForSlug } from "../../../utils/blog-series";

export async function getStaticPaths() {
  const paths = [];
  for (const lang of LOCALES) {
    const posts = (await getLocalizedCollection("blog", lang)).filter(isVisibleInDev);
    for (const post of posts) {
      paths.push({
        params: { lang, slug: stripLocale(post.id) },
        props: { post },
      });
    }
  }
  return paths;
}

const { post } = Astro.props;
const lang = normalizeLocale(Astro.params.lang);
const t = getLabels(lang);
const { common, share, blog, readingTime: readingTimeLabel, lightbox } = t;
const readingMin = estimateReadingTime(post.body ?? "");
const { Content } = await render(post);

// 連載記事なら、対応するプロダクト LP への導線（記事末 CTA + 固定ピル）を出す。
// 判定は slug ベースなので ja / en どちらの記事でも同一に効く。
const slug = stripLocale(post.id);
const series = findSeriesForSlug(slug);
const seriesProduct = series
  ? (await getLocalizedCollection("product", lang)).find(
      (p) => stripLocale(p.id) === series.productSlug,
    ) ?? null
  : null;
const seriesProductUrl =
  series && seriesProduct ? localeUrl(lang, `product/${series.productSlug}/`) : null;
// dev 環境でのみ下書き/予約投稿バナーを表示（本番では表示しない）
const isDev = import.meta.env.DEV;
const isDraft = isDev && post.data.draft === true;
const isScheduled = isDev && !post.data.draft && post.data.date > new Date();

// シェア用 URL とテキストをビルド時に生成
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const shareText = `${post.data.title} | Teppei Suyama`;
const xShareUrl = buildXShareUrl(pageUrl, shareText);
const shareClipboardText = `${post.data.title} | Teppei Suyama\n${pageUrl}`;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  publishedDate={post.data.date.toISOString()}
  tags={post.data.tags}
>
  {isDraft && (
    <div class="draft-banner">
      {blog.draftBanner}
    </div>
  )}
  {isScheduled && (
    <div class="scheduled-banner">
      {blog.scheduledBanner}
    </div>
  )}
  <article class="prose">
    <header class="hero-gradient fade-in">
      <h1>{post.data.title}</h1>
      <div class="article-meta">
        <span class="meta-item">
          <span class="meta-icon">&#128197;</span>
          {post.data.date.toLocaleDateString(BCP47[lang])}
        </span>
        <span class="meta-divider"></span>
        <span class="meta-item">
          <span class="meta-icon">&#9201;</span>
          {readingTimeLabel(readingMin)}
        </span>
        <span class="meta-divider"></span>
        <span class="meta-item meta-tags">
          {post.data.tags.slice(0, 4).map((tag) => (
            <a
              href={localeUrl(lang, `blog/tag/${tagToSlug(tag)}/`)}
              class="tag tag-link"
              data-astro-reload
            >{tag}</a>
          ))}
          {post.data.tags.length > 4 && <span class="tag tag-more">+{post.data.tags.length - 4}</span>}
        </span>
      </div>
    </header>

    <!-- モバイル: 折りたたみ目次 -->
    <nav class="toc-mobile reveal" aria-label={common.tocTitle}>
      <button class="toc-mobile-toggle" type="button" aria-expanded="false">
        <span class="toc-mobile-icon">&#9776;</span>
        <span>{common.tocTitle}</span>
        <span class="toc-mobile-chevron">&#9660;</span>
      </button>
      <ol class="toc-mobile-list" id="tocMobileList"></ol>
    </nav>

    <div class="blog-layout">
      <div class="content reveal">
        <Content />
      </div>

      <!-- PC: サイドバー固定目次 -->
      <aside class="toc-sidebar" aria-label={common.tocTitle}>
        <nav class="toc-sidebar-inner">
          <p class="toc-sidebar-title">{common.tocTitle}</p>
          <ol class="toc-sidebar-list" id="tocSidebarList"></ol>
        </nav>
      </aside>
    </div>
  </article>

  <!-- SNS シェアボタン -->
  <div class="share-section reveal">
    <p class="share-title">{share.title}</p>
    <div class="share-buttons">
      <a
        href={xShareUrl}
        target="_blank"
        rel="noopener"
        class="share-btn share-x"
        aria-label={share.x}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
        <span>{share.x}</span>
      </a>
      <button
        class="share-btn share-text-copy"
        data-share-text={shareClipboardText}
        aria-label={share.copyText}
        data-label={share.copyText}
        data-copied={share.copied}
        type="button"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <span>{share.copyText}</span>
      </button>
      <button
        class="share-btn share-copy"
        data-url={pageUrl}
        aria-label={share.copyLink}
        data-label={share.copyLink}
        data-copied={share.copied}
        type="button"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
        </svg>
        <span>{share.copyLink}</span>
      </button>
    </div>
  </div>

  {series && seriesProduct && seriesProductUrl && (
    <aside class="series-cta reveal" aria-label={blog.seriesCta.eyebrow}>
      <div class="series-cta-body">
        <p class="series-cta-eyebrow">{blog.seriesCta.eyebrow}</p>
        <p class="series-cta-title">{seriesProduct.data.title}</p>
        <p class="series-cta-tagline">{seriesProduct.data.tagline}</p>
      </div>
      <a href={seriesProductUrl} class="btn-cta series-cta-btn">
        {blog.seriesCta.button} &rarr;
      </a>
    </aside>
  )}

  <section class="bottom-cta reveal">
    <h2>{common.ctaTitle}</h2>
    <p>{common.ctaBody}</p>
    <a href={localeUrl(lang, "contact/")} class="btn-cta">{common.ctaButton}</a>
  </section>
  <nav class="back reveal">
    <a href="#" onclick="history.back(); return false;">&larr; {common.backLink}</a>
  </nav>

  {series && seriesProduct && seriesProductUrl && (
    <div class="series-float" id="seriesFloat" data-series-key={series.key}>
      <a
        href={seriesProductUrl}
        class="series-float-link"
        aria-label={blog.seriesCta.floatingAria}
      >
        <img
          src="/HomePage/mascot-owl.png"
          alt=""
          width="36"
          height="36"
          class="series-float-icon"
          loading="lazy"
          decoding="async"
        />
        <span class="series-float-text">{seriesProduct.data.title}</span>
        <span class="series-float-arrow" aria-hidden="true">&rarr;</span>
      </a>
      <button
        type="button"
        class="series-float-close"
        aria-label={blog.seriesCta.dismissAria}
      >&times;</button>
    </div>
  )}

  <ImageLightbox labels={lightbox} />

  <script is:inline>
    // コピーボタン共通ハンドラ
    function initShareCopy() {
      // シェア用テキストコピー（タイトル + URL）
      document.querySelectorAll(".share-text-copy").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var text = btn.getAttribute("data-share-text");
          var label = btn.getAttribute("data-label");
          var copied = btn.getAttribute("data-copied");
          var span = btn.querySelector("span");
          if (!text || !span) return;
          navigator.clipboard.writeText(text).then(function () {
            span.textContent = copied;
            btn.classList.add("copied");
            setTimeout(function () { span.textContent = label; btn.classList.remove("copied"); }, 2000);
          });
        });
      });
      // URL のみコピー
      document.querySelectorAll(".share-copy").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var url = btn.getAttribute("data-url");
          var label = btn.getAttribute("data-label");
          var copied = btn.getAttribute("data-copied");
          var span = btn.querySelector("span");
          if (!url || !span) return;
          navigator.clipboard.writeText(url).then(function () {
            span.textContent = copied;
            btn.classList.add("copied");
            setTimeout(function () { span.textContent = label; btn.classList.remove("copied"); }, 2000);
          });
        });
      });
    }
    initShareCopy();
    document.addEventListener("astro:after-swap", initShareCopy);

    // ===== 目次（TOC）の自動生成 =====
    function initToc() {
      var content = document.querySelector(".content");
      var mobileList = document.getElementById("tocMobileList");
      var sidebarList = document.getElementById("tocSidebarList");
      if (!content || (!mobileList && !sidebarList)) return;

      // 記事内の H2/H3 を取得（H4 以下は目次に含めない）
      var headings = content.querySelectorAll("h2, h3");
      if (headings.length === 0) {
        // 見出しがない記事では目次を非表示
        var tocMobile = document.querySelector(".toc-mobile");
        var tocSidebar = document.querySelector(".toc-sidebar");
        if (tocMobile) tocMobile.style.display = "none";
        if (tocSidebar) tocSidebar.style.display = "none";
        return;
      }

      var fragment1 = document.createDocumentFragment();
      var fragment2 = document.createDocumentFragment();
      var observeTargets = [];
      var h2Count = 0;
      var h3Count = 0;

      headings.forEach(function (h, i) {
        // id がない見出しにスラッグを付与
        if (!h.id) {
          h.id = "heading-" + i;
        }

        var text = (h.textContent || "").trim();
        if (!text) return; // 空の見出しはスキップ

        var isH3 = h.tagName === "H3";

        // 連番を算出
        var num;
        if (isH3) {
          h3Count++;
          num = h2Count + "." + h3Count;
        } else {
          h2Count++;
          h3Count = 0;
          num = String(h2Count);
        }

        observeTargets.push(h);

        function createTocItem(className) {
          var li = document.createElement("li");
          if (isH3) li.className = "toc-indent";
          var a = document.createElement("a");
          a.href = "#" + h.id;
          // 連番 + テキスト
          var numSpan = document.createElement("span");
          numSpan.className = "toc-num";
          numSpan.textContent = num;
          var labelSpan = document.createElement("span");
          labelSpan.className = "toc-label";
          labelSpan.textContent = text;
          a.appendChild(numSpan);
          a.appendChild(labelSpan);
          if (className) a.setAttribute("data-heading-id", h.id);
          li.appendChild(a);
          return li;
        }

        // モバイル用
        if (mobileList) {
          var li1 = createTocItem(null);
          li1.querySelector("a").addEventListener("click", function () {
            var toggle = document.querySelector(".toc-mobile-toggle");
            var list = document.getElementById("tocMobileList");
            if (toggle && list) {
              toggle.setAttribute("aria-expanded", "false");
              list.classList.remove("is-open");
            }
          });
          fragment1.appendChild(li1);
        }

        // サイドバー用
        if (sidebarList) {
          fragment2.appendChild(createTocItem("sidebar"));
        }
      });

      if (mobileList) mobileList.appendChild(fragment1);
      if (sidebarList) sidebarList.appendChild(fragment2);

      // モバイル: 折りたたみトグル
      var toggleBtn = document.querySelector(".toc-mobile-toggle");
      if (toggleBtn && mobileList) {
        toggleBtn.addEventListener("click", function () {
          var isOpen = toggleBtn.getAttribute("aria-expanded") === "true";
          toggleBtn.setAttribute("aria-expanded", isOpen ? "false" : "true");
          mobileList.classList.toggle("is-open", !isOpen);
        });
      }

      // PC: Intersection Observer で現在位置をハイライト
      if (sidebarList && observeTargets.length > 0 && typeof IntersectionObserver !== "undefined") {
        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            var links = sidebarList.querySelectorAll("a");
            links.forEach(function (link) {
              link.classList.toggle(
                "is-active",
                link.getAttribute("data-heading-id") === entry.target.id
              );
            });
          });
        }, { rootMargin: "-80px 0px -60% 0px", threshold: 0 });

        observeTargets.forEach(function (target) {
          observer.observe(target);
        });
      }
    }
    initToc();
    document.addEventListener("astro:after-swap", initToc);

    // ===== 連載 LP 導線の固定ピル =====
    // リンク自体は JS 無効でも表示・クロール可能（CSS で初期表示）。
    // JS はセッション内の「閉じた」状態の記憶と閉じる操作のみを担う。
    function initSeriesFloat() {
      var el = document.getElementById("seriesFloat");
      if (!el) return;
      var key = "seriesFloatDismissed:" + (el.getAttribute("data-series-key") || "");
      try {
        if (sessionStorage.getItem(key) === "1") {
          el.classList.add("is-dismissed");
          return;
        }
      } catch (e) {}
      var closeBtn = el.querySelector(".series-float-close");
      if (closeBtn && closeBtn.dataset.bound !== "1") {
        closeBtn.dataset.bound = "1";
        closeBtn.addEventListener("click", function () {
          el.classList.add("is-dismissed");
          try { sessionStorage.setItem(key, "1"); } catch (e) {}
        });
      }
    }
    initSeriesFloat();
    document.addEventListener("astro:after-swap", initSeriesFloat);

  </script>
</BaseLayout>

<style>
  .draft-banner {
    background-color: rgba(234, 179, 8, 0.15);
    color: #ca8a04;
    border: 1px solid rgba(234, 179, 8, 0.3);
    border-radius: 0.5rem;
    padding: 0.75rem 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    text-align: center;
    margin-bottom: 1.5rem;
  }
  .scheduled-banner {
    background-color: rgba(59, 130, 246, 0.15);
    color: #2563eb;
    border: 1px solid rgba(59, 130, 246, 0.3);
    border-radius: 0.5rem;
    padding: 0.75rem 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    text-align: center;
    margin-bottom: 1.5rem;
  }

  header {
    margin-bottom: 2rem;
  }
  header h1 {
    margin-bottom: 0.75rem;
  }
  .article-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    padding: 0.6rem 0;
    border-top: 1px solid var(--color-border);
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }
  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .meta-icon {
    font-size: 0.85rem;
    line-height: 1;
  }
  .meta-divider {
    width: 1px;
    height: 0.9rem;
    background-color: var(--color-border);
    flex-shrink: 0;
  }
  .meta-tags {
    display: inline-flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .content {
    margin-top: 2rem;
    min-width: 0; /* flex child のオーバーフロー防止 */
  }

  /* ===== Blog Layout (本文と TOC は分離。TOC は画面右に fixed) ===== */
  .blog-layout {
    display: block;
  }
  .blog-layout .content {
    width: 100%;
  }

  /* ===== レスポンシブ ===== */
  @media (min-width: 1080px) {
    /* ブログ記事ページだけ main の幅を拡張（サイドバー分） */
    :global(main) { max-width: 1200px; }
  }

  /* ===== 画面幅 1720px 未満：サイドバー目次は出さず、先頭の折りたたみ目次のみ表示 =====
     ブレイクポイント設計: 1620px 時点では main 右端(1410px) と TOC 左端(1236px)が重なるため、
     main(max 1080px 中央寄せ) と TOC(280px) が重ならない 1720px に閾値を引き上げる。 */
  @media (max-width: 1719px) {
    .blog-layout { flex-direction: column; }
    .toc-sidebar { display: none; }
  }

  /* ===== 画面幅 1720px 以上：目次を画面右上に常時固定 =====
     重なり防止のため main の最大幅を 1080px に縮め、 TOC は 280px 幅で右に固定。
     1720px 時点で main 右端 1400px / TOC 左端 1416px、 16px の余白で衝突しない。 */
  @media (min-width: 1720px) {
    .toc-mobile { display: none; }
    :global(main) { max-width: 1080px; }
    .toc-sidebar {
      display: block;
      position: fixed;
      top: 90px;
      right: 24px;
      width: 280px;
      max-height: calc(100vh - 110px);
      overflow-y: auto;
      z-index: 10;
    }
  }

  /* Share buttons */
  .share-section {
    margin-top: 3rem;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background-color: var(--color-surface);
    text-align: center;
  }
  .share-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .share-buttons {
    display: flex;
    gap: 0.6rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 600;
    border: 1px solid var(--color-border);
    background-color: transparent;
    background-image: none;
    color: var(--color-text);
    cursor: pointer;
    transition: transform 0.2s, border-color 0.2s, color 0.2s, background-color 0.2s;
  }
  .share-btn:hover {
    transform: translateY(-2px);
  }
  .share-x:hover {
    border-color: #1d9bf0;
    color: #1d9bf0;
  }
  .share-text-copy:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  .share-text-copy.copied {
    border-color: #22c55e;
    color: #22c55e;
  }
  .share-copy:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .share-copy.copied {
    border-color: #22c55e;
    color: #22c55e;
  }

  .back {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .bottom-cta { margin-top: 3rem; padding: 2.5rem 1.5rem; text-align: center; border: 1px solid var(--color-border); border-radius: 0.75rem; background-color: var(--color-surface); }
  .bottom-cta h2 { margin-bottom: 0.5rem; }
  .bottom-cta p { color: var(--color-text-muted); font-size: 0.95rem; margin-bottom: 1.5rem; }
  .btn-cta { display: inline-block; padding: 0.75rem 2rem; border-radius: 9999px; background: linear-gradient(135deg, var(--color-primary), #8b5cf6); color: white; font-weight: 600; background-image: none; transition: transform 0.25s, box-shadow 0.25s; }
  .btn-cta:hover { transform: translateY(-2px); box-shadow: 0 6px 20px var(--color-primary-glow); color: white; }

  /* ===== 連載 LP 導線：記事末 CTA カード ===== */
  .series-cta {
    margin-top: 3rem;
    padding: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    flex-wrap: wrap;
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: 0.75rem;
    background-color: var(--color-surface);
  }
  .series-cta-body { flex: 1; min-width: 220px; }
  .series-cta-eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.35rem;
  }
  .series-cta-title { font-size: 1.15rem; font-weight: 700; margin-bottom: 0.2rem; }
  .series-cta-tagline { color: var(--color-text-muted); font-size: 0.9rem; margin: 0; }
  .series-cta-btn { flex-shrink: 0; white-space: nowrap; }

  /* ===== 連載 LP 導線：画面端の固定ピル ===== */
  /* 本文を覆わない小型サイズ。リンクは初期表示（JS 無効でもクロール可能）。 */
  .series-float {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 0.15rem;
    padding: 0.35rem 0.4rem 0.35rem 0.5rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
    max-width: calc(100vw - 2.5rem);
    animation: seriesFloatIn 0.4s ease both;
  }
  :global(.dark) .series-float { box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4); }
  .series-float.is-dismissed { display: none; }
  .series-float-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    padding: 0.1rem 0.35rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text);
    background-image: none;
  }
  .series-float-link:hover { color: var(--color-primary); }
